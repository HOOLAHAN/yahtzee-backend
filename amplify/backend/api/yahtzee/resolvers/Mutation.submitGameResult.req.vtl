{
  "version": "2018-05-29",
  "operation": "PutItem",
  "key": { "id": $util.dynamodb.toDynamoDBJson($id) },
  "attributeValues": {
    "userId": $util.dynamodb.toDynamoDBJson($sub),
    "username": $util.dynamodb.toDynamoDBJson($username),
    "mode": $util.dynamodb.toDynamoDBJson($mode),
    "modeDate": $util.dynamodb.toDynamoDBJson($modeDate),
    "challengeDate": $util.dynamodb.toDynamoDBJson($ctx.args.input.challengeDate),
    "score": $util.dynamodb.toDynamoDBJson($ctx.args.input.score),
    "completedAt": $util.dynamodb.toDynamoDBJson($timestamp),
    "yahtzeeCount": $util.dynamodb.toDynamoDBJson($ctx.args.input.yahtzeeCount),
    "earnedUpperBonus": $util.dynamodb.toDynamoDBJson($ctx.args.input.earnedUpperBonus),
    "completedSmallStraight": $util.dynamodb.toDynamoDBJson($ctx.args.input.completedSmallStraight),
    "completedLargeStraight": $util.dynamodb.toDynamoDBJson($ctx.args.input.completedLargeStraight),
    "noZeroScores": $util.dynamodb.toDynamoDBJson($ctx.args.input.noZeroScores),
    "yahtzeeOnFinalRoll": $util.dynamodb.toDynamoDBJson($ctx.args.input.yahtzeeOnFinalRoll),
    "scorecard": $util.dynamodb.toDynamoDBJson($ctx.args.input.scorecard),
    "session": $util.dynamodb.toDynamoDBJson($ctx.args.input.session),
    "createdAt": $util.dynamodb.toDynamoDBJson($timestamp),
    "updatedAt": $util.dynamodb.toDynamoDBJson($timestamp),
    "__typename": $util.dynamodb.toDynamoDBJson("GameResult")
  },
  "condition": { "expression": "attribute_not_exists(id)" }
}
