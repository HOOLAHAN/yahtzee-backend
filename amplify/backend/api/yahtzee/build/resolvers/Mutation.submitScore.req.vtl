{
  "version": "2018-05-29",
  "operation": "PutItem",
  "key": {
    "id": $util.dynamodb.toDynamoDBJson($id)
  },
  "attributeValues": {
    "userId": $util.dynamodb.toDynamoDBJson($ctx.identity.sub),
    "username": $util.dynamodb.toDynamoDBJson($username),
    "score": $util.dynamodb.toDynamoDBJson($ctx.args.score),
    "timestamp": $util.dynamodb.toDynamoDBJson($timestamp),
    "createdAt": $util.dynamodb.toDynamoDBJson($timestamp),
    "updatedAt": $util.dynamodb.toDynamoDBJson($timestamp),
    "__typename": $util.dynamodb.toDynamoDBJson("Score")
  },
  "condition": {
    "expression": "attribute_not_exists(id)"
  }
}
